import { bindings, defineConfig } from "cf/config";

/**
 * Wrangler environments are selected through ctx.mode and the cf --mode flag.
 *
 * - no --mode (Vite dev/build default): the top-level `blog` worker
 *   (equivalent to the old top-level wrangler.toml section)
 * - `--mode local`: the old `--env local` (local D1 database id)
 * - `--mode prod`: the old `--env production` (custom domain route).
 *   Renamed from `production` so Vite's default `production` mode does
 *   not select it implicitly.
 * @see https://developers.cloudflare.com/workers/wrangler/environments/
 */
export default defineConfig((ctx) => {
  switch (ctx.mode) {
    case "local": {
      return {
        worker: {
          name: "blog-local",
          compatibilityDate: "2024-12-01",
          compatibilityFlags: ["nodejs_compat"],
          entrypoint: "src/worker-entry.ts",
          env: {
            RP_ID: bindings.text("your-domain.com"),
            RP_ORIGIN: bindings.text("https://your-domain.com"),
            RP_NAME: bindings.text("Your Site Name"),
            OAUTH_RP_ID: bindings.text("your-domain.com"),
            OAUTH_RP_ORIGIN: bindings.text("https://your-domain.com"),
            BLOG_DB: bindings.d1({
              name: "blog-db",
              id: "local-blog-db",
            }),
            ADMIN_AUTH: bindings.kv({
              id: "YOUR_KV_NAMESPACE_ID",
            }),
            OAUTH_AUTH: bindings.kv({
              id: "YOUR_OAUTH_KV_NAMESPACE_ID",
            }),
            ASSETS: bindings.assets(),
          },
        },
      };
    }
    case "prod": {
      return {
        worker: {
          name: "blog-production",
          compatibilityDate: "2024-12-01",
          compatibilityFlags: ["nodejs_compat"],
          entrypoint: "src/worker-entry.ts",
          domains: ["your-domain.com"],
          env: {
            RP_ID: bindings.text("your-domain.com"),
            RP_ORIGIN: bindings.text("https://your-domain.com"),
            RP_NAME: bindings.text("Your Site Name"),
            OAUTH_RP_ID: bindings.text("your-domain.com"),
            OAUTH_RP_ORIGIN: bindings.text("https://your-domain.com"),
            BLOG_DB: bindings.d1({
              name: "blog-db",
              id: "YOUR_D1_DATABASE_ID",
            }),
            ADMIN_AUTH: bindings.kv({
              id: "YOUR_KV_NAMESPACE_ID",
            }),
            OAUTH_AUTH: bindings.kv({
              id: "YOUR_OAUTH_KV_NAMESPACE_ID",
            }),
            ASSETS: bindings.assets(),
          },
        },
      };
    }
    default: {
      return {
        worker: {
          name: "blog",
          compatibilityDate: "2024-12-01",
          compatibilityFlags: ["nodejs_compat"],
          entrypoint: "src/worker-entry.ts",
          env: {
            RP_ID: bindings.text("your-domain.com"),
            RP_ORIGIN: bindings.text("https://your-domain.com"),
            RP_NAME: bindings.text("Your Site Name"),
            OAUTH_RP_ID: bindings.text("your-domain.com"),
            OAUTH_RP_ORIGIN: bindings.text("https://your-domain.com"),
            BLOG_DB: bindings.d1({
              name: "blog-db",
              id: "YOUR_D1_DATABASE_ID",
            }),
            ADMIN_AUTH: bindings.kv({
              id: "YOUR_KV_NAMESPACE_ID",
            }),
            OAUTH_AUTH: bindings.kv({
              id: "YOUR_OAUTH_KV_NAMESPACE_ID",
            }),
            ASSETS: bindings.assets(),
          },
        },
      };
    }
  }
});
